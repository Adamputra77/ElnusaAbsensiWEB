@startuml
skinparam backgroundColor #FEFEFE
skinparam rectangleStyle simple
skinparam rectangleBorderColor #333333
skinparam rectangleBackgroundColor #E8F0FE
skinparam arrowColor #333333

rectangle Admin as admin
rectangle Security as security
rectangle Employee as employee
rectangle "Sistem Absensi\nWarehouse Elnusa BSD" as system

admin -right-> system : Data Login,\nKelola Pegawai,\nFilter/Ekspor
system -right-> admin : Log Absensi,\nStatus Presensi,\nKartu Identitas

security -right-> system : Data Login,\nScan NIK/QR
system -right-> security : Notifikasi Scan,\nStatistik Harian

employee -right-> system : Data Login (NIK)
system -right-> employee : QR/Barcode,\nHistori Absensi

@enduml
